<UserControl
    x:Class="RZDP_IFC_Viewer.View.Controls.EditorProperty"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.fontawesome.io/icons/"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wind="clr-namespace:RZDP_IFC_Viewer"
    Height="auto"
    MinWidth="200"
    DataContextChanged="UserControl_DataContextChanged"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="1" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <ContextMenu x:Key="TextBoxMenuPropertySet">
            <MenuItem Click="MenuItemDublicate_Click" Header="Дублировать">
                <MenuItem.Icon>
                    <fa:ImageAwesome
                        Height="12"
                        Margin="0,0,3,0"
                        Foreground="DarkGreen"
                        Icon="Copy" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuItemUnpin_Click" Header="Открепить">
                <MenuItem.Icon>
                    <fa:ImageAwesome
                        Height="12"
                        Margin="0,0,3,0"
                        Foreground="DarkBlue"
                        Icon="Scissors" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuItemDelete_Click" Header="Удалить">
                <MenuItem.Icon>
                    <fa:ImageAwesome
                        Height="12"
                        Margin="0,0,3,0"
                        Foreground="DarkRed"
                        Icon="Remove" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="TextBoxMenuProperty">
            <MenuItem Click="MenuItemDelete_Click" Header="Удалить">
                <MenuItem.Icon>
                    <fa:ImageAwesome
                        Height="12"
                        Margin="0,0,3,0"
                        Foreground="DarkRed"
                        Icon="Remove" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>


    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*" MinWidth="220" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="5"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Наименование элемента: " />
                <TextBox
                    x:Name="tbName"
                    MinWidth="300"
                    BorderThickness="1"
                    Focusable="False"
                    IsEnabled="{Binding Path=(wind:MainWindow.IsEnabled)}"
                    IsReadOnly="{Binding Path=(wind:MainWindow.IsReadOnly)}"
                    LostFocus="tbName_LostFocus"
                    MouseDoubleClick="TextBox_MouseDoubleClick"
                    Text="{Binding Path=IFCObjectName, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="GUID: " />
                <TextBlock Text="{Binding Path=IFCObjectGUID}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Класс IFC: " />
                <TextBlock Text="{Binding Path=IFCClass}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button
                    Name="ExportParametersToXML"
                    Width="auto"
                    Padding="5,0,5,0"
                    HorizontalAlignment="Left"
                    Click="Button_ExportParametersToXML_Click"
                    Content="Экспорт"
                    ToolTip="Экспорт параметров в XML файл" />
                <Button
                    Name="ImportParametersToXML"
                    Width="auto"
                    Padding="5,0,5,0"
                    HorizontalAlignment="Left"
                    Click="Button_ImportParametersToXML_Click"
                    Content="Импорт"
                    ToolTip="Импорт параметров из XML файла" />
            </StackPanel>
        </StackPanel>

        <!--  Наборы характеристик  -->

        <GroupBox
            Grid.Row="2"
            Grid.Column="0"
            Header="Наборы характеристик">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="3"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding AddPropertySetCommand}"
                        IsEnabled="{Binding Path=(wind:MainWindow.IsEnabled)}"
                        ToolTip="Добавить новый набор">
                        <fa:ImageAwesome
                            Width="25"
                            Height="25"
                            Margin="0,0,0,0"
                            Foreground="DarkBlue"
                            Icon="Plus" />
                    </Button>
                </StackPanel>
                <DataGrid
                    x:Name="dgPropertySet"
                    Grid.Row="1"
                    Width="auto"
                    AutoGenerateColumns="False"
                    CanUserDeleteRows="False"
                    IsSynchronizedWithCurrentItem="True"
                    ItemsSource="{Binding Path=CollectionPropertySet, UpdateSourceTrigger=LostFocus}"
                    SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="100"
                            CanUserSort="False"
                            Header="Наименование"
                            SortMemberPath="{Binding Path=NamePropertySet}"
                            Visibility="Visible">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        ContextMenu="{StaticResource TextBoxMenuPropertySet}"
                                        Focusable="False"
                                        Foreground="Black"
                                        IsReadOnly="{Binding Path=(wind:MainWindow.IsReadOnly)}"
                                        LostFocus="tbName_LostFocus"
                                        MouseDoubleClick="TextBox_MouseDoubleClick"
                                        Text="{Binding Path=NamePropertySet, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="70"
                            MinWidth="70"
                            CanUserSort="False"
                            Header="Экземпляр"
                            SortMemberPath="{Binding Path=CountRelatedObjectsInstance}"
                            Visibility="Visible">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        ContextMenu="{StaticResource TextBoxMenuPropertySet}"
                                        Focusable="False"
                                        IsReadOnly="True"
                                        Text="{Binding Path=CountRelatedObjectsInstance, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="35"
                            MinWidth="35"
                            CanUserSort="False"
                            Header="Тип"
                            SortMemberPath="{Binding Path=CountRelatedObjectsType}"
                            Visibility="Visible">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        ContextMenu="{StaticResource TextBoxMenuPropertySet}"
                                        Focusable="False"
                                        IsReadOnly="True"
                                        Text="{Binding Path=CountRelatedObjectsType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GridSplitter
            Grid.Row="2"
            Grid.Column="1"
            Width="20"
            HorizontalAlignment="Center" />

        <!--  Характеристики  -->

        <GroupBox
            Grid.Row="2"
            Grid.Column="2"
            Header="Характеристики">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Margin="3"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding AddPropertyCommand}"
                        CommandParameter="{Binding ElementName=dgPropertySet, Path=SelectedItem}"
                        IsEnabled="{Binding Path=(wind:MainWindow.IsEnabled)}"
                        ToolTip="Добавить новое свойство">
                        <fa:ImageAwesome
                            Width="25"
                            Height="25"
                            Margin="0,0,0,0"
                            Foreground="DarkBlue"
                            Icon="Plus" />
                    </Button>
                </StackPanel>
                <DataGrid
                    x:Name="dgProperty"
                    Grid.Row="1"
                    Width="auto"
                    AutoGenerateColumns="False"
                    ItemsSource="{Binding ElementName=dgPropertySet, Path=SelectedItem.PropertyCollection, UpdateSourceTrigger=LostFocus}"
                    SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="100"
                            CanUserSort="False"
                            Header="Наименование"
                            IsReadOnly="False"
                            SortMemberPath="{Binding Path=NameProperty}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        ContextMenu="{StaticResource TextBoxMenuProperty}"
                                        Focusable="False"
                                        Foreground="Black"
                                        IsReadOnly="{Binding Path=(wind:MainWindow.IsReadOnly)}"
                                        LostFocus="tbName_LostFocus"
                                        MouseDoubleClick="TextBox_MouseDoubleClick"
                                        Text="{Binding Path=NameProperty, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="100"
                            CanUserSort="False"
                            Header="Значение"
                            IsReadOnly="False"
                            SortMemberPath="{Binding Path=ValueString}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        ContextMenu="{StaticResource TextBoxMenuProperty}"
                                        Focusable="False"
                                        Foreground="Black"
                                        IsReadOnly="{Binding Path=(wind:MainWindow.IsReadOnly)}"
                                        LostFocus="tbName_LostFocus"
                                        MouseDoubleClick="TextBox_MouseDoubleClick"
                                        Text="{Binding Path=ValueString, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn
                            Width="*"
                            MinWidth="100"
                            MaxWidth="150"
                            CanUserSort="False"
                            Header="Тип данных"
                            IsReadOnly="True"
                            SortMemberPath="{Binding Path=DataType}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        ContextMenu="{StaticResource TextBoxMenuProperty}"
                                        Focusable="False"
                                        IsReadOnly="True"
                                        Text="{Binding Path=DataType, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>